{
  "name": "ashborn",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:1420 && npm run electron:build && electron .\"",
    "build": "vite build && npm run electron:build",
    "electron:start": "electron .",
    "preview": "vite preview",
    "test": "npm run electron:build && npm run -s agent:build && playwright test",
    "agent:build": "esbuild mcp/server.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist-mcp/server.mjs",
    "agent:login": "npm run agent:build && node dist-mcp/server.mjs login",
    "agent": "npm run -s agent:build && node dist-mcp/server.mjs",
    "android:build": "vite build && cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-$HOME/Android/jdk-21} ./gradlew assembleDebug -q",
    "android:install": "npm run android:build && $HOME/Android/Sdk/platform-tools/adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "electron": "^37.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.1"
  }
}
